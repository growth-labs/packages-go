{
	"id": "authorization-code-token",
	"description": "Authorization-code exchange and decoded user access-token contract.",
	"request": {
		"method": "POST",
		"path": "/token",
		"content_type": "application/x-www-form-urlencoded",
		"form": {
			"grant_type": "authorization_code",
			"code": "conformance-authorization-code",
			"code_verifier": "test-code-verifier-0123456789012345678901234567890123456789",
			"client_id": "conformance-public-client",
			"redirect_uri": "https://consumer.example.test/api/auth/callback",
			"resource": "https://consumer.example.test"
		}
	},
	"success": {
		"status": 200,
		"body": {
			"type": "object",
			"required": ["access_token", "refresh_token", "token_type", "expires_in"],
			"properties": {
				"access_token": {
					"type": "string",
					"pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
				},
				"refresh_token": {
					"type": "string",
					"pattern": "^user:[0-7][0-9A-HJKMNP-TV-Z]{25}:.+$"
				},
				"token_type": {
					"const": "Bearer"
				},
				"expires_in": {
					"type": "integer",
					"minimum": 1,
					"maximum": 900
				}
			}
		}
	},
	"access_token_claims": {
		"type": "object",
		"required": [
			"iss",
			"sub",
			"aud",
			"mode",
			"type",
			"scope",
			"client_id",
			"roles",
			"iat",
			"exp",
			"properties"
		],
		"properties": {
			"iss": {
				"const": "https://auth.fulcrum-labs.com"
			},
			"sub": {
				"type": "string",
				"pattern": "^user:[0-7][0-9A-HJKMNP-TV-Z]{25}$"
			},
			"aud": {
				"const": "https://consumer.example.test"
			},
			"mode": {
				"const": "access"
			},
			"type": {
				"const": "user"
			},
			"scope": {
				"const": "openid email profile"
			},
			"client_id": {
				"const": "conformance-public-client"
			},
			"roles": {
				"const": ["member"]
			},
			"iat": {
				"type": "integer"
			},
			"exp": {
				"type": "integer"
			},
			"properties": {
				"type": "object",
				"required": ["userId", "email", "name", "image", "isNewUser"],
				"properties": {
					"userId": {
						"type": "string",
						"pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
					},
					"email": {
						"const": "member@example.test"
					},
					"name": {
						"const": "Conformance Member"
					},
					"image": {
						"const": "https://consumer.example.test/avatar.png"
					},
					"isNewUser": {
						"const": false
					}
				}
			}
		},
		"invariants": [
			"sub_suffix_equals_properties.userId",
			"exp_minus_iat_equals_manifest.constants.access_token_ttl_seconds"
		]
	}
}
